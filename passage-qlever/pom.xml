<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fr.gdd</groupId>
  <artifactId>passage-qlever</artifactId>
  <name>passage-qlever</name>
  <packaging>jar</packaging>

  <parent>
    <groupId>fr.gdd</groupId>
    <artifactId>passage</artifactId>
    <version>0.2.0</version>
  </parent>

  <!-- The scans come from a QLever index through a JNI bridge, so this module
       needs no RDF store of its own: the native library `libqleverjni` carries
       all of it. See `NATIVE.md`. -->
  <dependencies>
    <dependency>
      <groupId>fr.gdd</groupId>
      <artifactId>passage-commons</artifactId>
    </dependency>

    <dependency> <!-- logger of jena -->
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Build the JNI bridge from the `qlever` submodule and put it where
         `QLeverNative.load()` finds it on the classpath. Not part of the
         default build: it needs a C++ toolchain and takes much longer than the
         rest of this module, so an ordinary `mvn install` leaves it alone and
         the tests then skip. See NATIVE.md. -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>build-qleverjni</id>
                <phase>process-classes</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${project.basedir}/build-native.sh</executable>
                  <arguments>
                    <argument>${project.build.outputDirectory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
