{
  "name": "passage-qlever",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/java:1.6.4": {
      "version": "21",
      "installMaven": true
    }
  },

  // The C++ build is the constraint, not the JVM: QLever is template-heavy
  // enough that a 2-core/8GB machine swaps and takes hours. This is exactly
  // the `standardLinux32gb` machine — asking for more storage than it has
  // would hide it and force the 8-core one, which costs twice as much for a
  // build that needs 2.7GB of disk.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "onCreateCommand": ".devcontainer/install-deps.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
