{
  "name": "passage-qlever",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // No "features" on purpose. A feature reference that cannot be resolved —
  // a version that does not exist, say — fails the whole container build, and
  // Codespaces then drops you into its recovery container: the workspace is
  // mounted, so the scripts are all there, but the image is not the one asked
  // for and nothing in it is what the scripts expect. Ubuntu 24.04 carries
  // `openjdk-21-jdk` and `maven` in apt, so `install-deps.sh` installs them
  // along with the C++ dependencies and there is nothing left to resolve.

  // The C++ build is the constraint, not the JVM: QLever is template-heavy
  // enough that a 2-core/8GB machine swaps and takes hours. This is exactly
  // the `standardLinux32gb` machine — asking for more storage than it has
  // would hide it and force the 8-core one, which costs twice as much for a
  // build that needs 2.7GB of disk.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "onCreateCommand": ".devcontainer/install-deps.sh",

  "customizations": {
    // A Codespace's token reaches only the repository it was created from, so
    // cloning the private `momo54/qlever` submodule fails with a 403 whose
    // message says "Write access to repository not granted" — misleading, it
    // is a read it cannot do either. This asks for that one extra read, and
    // GitHub prompts for authorization when the Codespace is created.
    //
    // It only applies to Codespaces created *after* this is committed:
    // rebuilding an existing one does not pick it up.
    "codespaces": {
      "repositories": {
        "momo54/qlever": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
